{
  "name": "smartmouse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SmartMouse Web — ブラウザから Windows Receiver を操作する緊急用マウス・キーボード",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node scripts/mock-receiver.mjs",
    "pair": "node scripts/pair-qr.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "bonjour-service": "^1.4.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
